{
  "expo": {
    "name": "synq",
    "slug": "synq",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcons/icon-blue.png",
    "scheme": "synq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101010"
    },
    "backgroundColor": "#101010",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.directedbyshawn.synq",
      "infoPlist": {
        "CFBundleDisplayName": "SYNQ",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "buildNumber": "20"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#101010"
      },
      "package": "com.directedbyshawn.synq"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "flipper": true
          }
        }
      ],
      [
        "expo-tracking-transparency"
      ],
      [
        "expo-icon-handler",
        {
          "icons": [
            {
              "name": "icon-blue",
              "path": "./assets/appIcons/icon-blue.png"
            },
            {
              "name": "icon-mint",
              "path": "./assets/appIcons/icon-mint.png"
            },
            {
              "name": "icon-red",
              "path": "./assets/appIcons/icon-red.png"
            },
            {
              "name": "icon-yellow",
              "path": "./assets/appIcons/icon-yellow.png"
            },
            {
              "name": "icon-purple",
              "path": "./assets/appIcons/icon-purple.png"
            },
            {
              "name": "icon-orange",
              "path": "./assets/appIcons/icon-orange.png"
            },
            {
              "name": "icon-pink",
              "path": "./assets/appIcons/icon-pink.png"
            }
          ]
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "assets/audio/ad.mp3"
          ]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "df86bb9d-1587-48b7-a40e-85a09eee2a72"
      }
    }
  }
}
