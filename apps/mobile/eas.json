{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.14.0",
      "pnpm": "10.32.1"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "internal": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "channel": "internal",
      "autoIncrement": true
    },
    "upgrade-test": {
      "extends": "internal",
      "autoIncrement": false,
      "env": {
        "APP_VARIANT": "development",
        "SYNQ_UPGRADE_TEST": "1"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6624313712",
        "appleTeamId": "39K6A9FP99"
      }
    }
  }
}
