{
  "name": "@synq/mobile",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo ios node_modules",
    "dev": "expo start",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore --ignore-path .gitignore",
    "ios": "expo run:ios",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts' 'plugins/*.test.cjs'",
    "typecheck": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts && tsgo --noEmit"
  },
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@legendapp/list": "^3.6.0",
    "@synq/audio": "workspace:*",
    "@synq/db": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "expo": "~57.0.26",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "posthog-react-native": "^4.85.1",
    "react": "catalog:react19",
    "react-native": "0.86.3",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "~10.16.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-native-zip-archive": "^9.5.3",
    "tailwindcss": "catalog:",
    "uniwind": "^1.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/config-plugins": "~57.0.9",
    "@synq/eslint-config": "workspace:*",
    "@synq/prettier-config": "workspace:*",
    "@synq/tsconfig": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "catalog:",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "prettier": "catalog:",
    "reassure": "^1.6.0",
    "typescript": "catalog:"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "prettier": "@synq/prettier-config"
}
