{
  "expo": {
    "name": "SYNQ New",
    "slug": "synq-new",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "synq-new",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
