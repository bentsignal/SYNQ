{
  "name": "synq",
  "private": true,
  "version": "3.0.0",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "turbo run build",
    "clean:all": "turbo run clean",
    "dev": "turbo run dev --parallel --continue",
    "dev:old": "pnpm --filter @synq/old dev",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format --continue -- --write",
    "lint": "turbo run lint --continue",
    "smoke:rewrite": "pnpm --filter @synq/rewrite-smoke smoke",
    "typecheck": "turbo run typecheck",
    "verify:rewrite": "bash scripts/verify-rewrite.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
