{
  "name": "synq",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.32.1"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules .turbo",
    "clean:all": "turbo run clean && pnpm run clean",
    "dev": "turbo run dev --parallel --continue",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "react-doctor": "pnpm dlx react-doctor@0.9.14 apps/mobile --scope changed --blocking warning --no-telemetry --no-supply-chain --no-score --yes",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck && pnpm -F @synq/mobile exec tsgo --noEmit -p perf",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "perf": "pnpm -F @synq/mobile exec reassure measure --testMatch '**/perf/*.perf-test.tsx'",
    "test": "turbo run test && pnpm -F @synq/mobile exec jest"
  },
  "devDependencies": {
    "@synq/prettier-config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "prettier": "catalog:",
    "turbo": "2.8.17",
    "typescript": "catalog:"
  },
  "prettier": "@synq/prettier-config",
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-core@57.0.20": "patches/expo-modules-core@57.0.20.patch",
      "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch"
    }
  }
}
