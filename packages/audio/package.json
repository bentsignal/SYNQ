{
  "name": "@synq/audio",
  "version": "0.0.0",
  "private": true,
  "description": "SYNQ's native playback engine: AVQueuePlayer queue playback, Now Playing, and remote commands, as an Expo module.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "git clean -xdf .build .swiftpm .cache .turbo node_modules",
    "test": "node --test 'src/**/*.test.ts'",
    "test:swift": "swift test",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@synq/eslint-config": "workspace:*",
    "@synq/prettier-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "~19.2.17",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "expo": "~57.0.26",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "typescript": "catalog:"
  },
  "prettier": "@synq/prettier-config"
}
