diff --git a/apple/Sources/ExpoModulesJSI/Runtime/JavaScriptRuntime.swift b/apple/Sources/ExpoModulesJSI/Runtime/JavaScriptRuntime.swift
index 58aea85c2002404ca7ac19e4c12f0552c67fab71..531d57d3750b3af8b4cad902728049fdf77fed94 100644
--- a/apple/Sources/ExpoModulesJSI/Runtime/JavaScriptRuntime.swift
+++ b/apple/Sources/ExpoModulesJSI/Runtime/JavaScriptRuntime.swift
@@ -217,8 +217,12 @@ open class JavaScriptRuntime: Equatable, Identifiable, @unchecked Sendable {
       (@convention(c) (UnsafeMutableRawPointer, UnsafePointer<CChar>, UnsafeMutableRawPointer) -> Void)? = setter
     // Pass a null setter to C++ when the Swift setter is nil so that JS assignment
     // raises a `jsi::JSError` directly, without crossing the Swift boundary.
-    let callbacks = expo.HostObjectCallbacks(
-      context, getter, set == nil ? nil : setterPointer, propertyNamesGetter, deallocate)
+    let callbacks =
+      if set == nil {
+        expo.HostObjectCallbacks(context, getter, nil, propertyNamesGetter, deallocate)
+      } else {
+        expo.HostObjectCallbacks(context, getter, setterPointer, propertyNamesGetter, deallocate)
+      }
     let hostObject = expo.HostObject.makeObject(pointee, consume callbacks)
 
     return JavaScriptObject(self, hostObject)
